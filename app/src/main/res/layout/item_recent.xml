<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal"
    android:gravity="center_vertical" android:background="@drawable/bg_list_item" android:paddingStart="14dp" android:paddingEnd="8dp">
    <TextView android:id="@+id/recentBadge" android:layout_width="44dp" android:layout_height="30dp" android:gravity="center" android:textSize="10sp" android:textColor="@color/accent_text" android:background="@drawable/bg_chip" android:fontFamily="sans-serif-medium" android:layout_marginEnd="12dp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/recentName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="14sp" android:singleLine="true" android:ellipsize="middle" />
        <TextView android:id="@+id/recentMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_tertiary" android:textSize="11sp" android:singleLine="true" />
    </LinearLayout>
    <ImageView android:id="@+id/recentRemove" android:layout_width="36dp" android:layout_height="36dp" android:padding="9dp" android:src="@drawable/ic_close" android:tint="@color/text_tertiary" android:background="@drawable/bg_flat_button" android:contentDescription="@string/clear" />
</LinearLayout>
